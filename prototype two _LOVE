<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Raider Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@300;400;500;600&display=swap">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<style>
  :root {
    --card: #131313;
    --line: #282828;
    --accent: #7c7cff;
    --accent-2: #b0b0ff;
    --accent-3: #c0c0ff;
    --text: #eaeaea;
    --muted: #888;
    --amber: #ffb44a;
    --hot: #ff5a4a;
    --good: #3ddc84;
    color-scheme: dark;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  button { font-family: inherit; }
  .brand, .now .name, .list h3, .sched-title, .stat b, .toast strong, .tpanel .grp { font-family: 'Outfit', 'Inter', system-ui, sans-serif; }
  html, body { height: 100%; }
  body { font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif; background: radial-gradient(circle at 20% 30%, #1a1a1a, #000); background-attachment: fixed; color: var(--text); overflow-x: hidden; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* ---------- Animated background ---------- */
  .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .5; animation: drift 22s ease-in-out infinite alternate; }
  .o1 { width: 46vmax; height: 46vmax; left: -12vmax; top: -10vmax; background: #3a3aff55; }
  .o2 { width: 40vmax; height: 40vmax; right: -12vmax; bottom: -12vmax; background: #8a2bff40; animation-duration: 28s; animation-delay: -6s; }
  .o3 { width: 28vmax; height: 28vmax; left: 45%; top: 35%; background: #00b4ff25; animation-duration: 34s; animation-delay: -12s; }
  @keyframes drift { 0% { transform: translate(0,0) scale(1); } 50% { transform: translate(6vmax,4vmax) scale(1.15); } 100% { transform: translate(-4vmax,8vmax) scale(.95); } }
  .grid-lines { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%); animation: gridmove 40s linear infinite; }
  @keyframes gridmove { to { background-position: 56px 56px; } }

  /* ---------- Screens ---------- */
  .screen { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; padding: 2rem 1.5rem; overflow-y: auto; z-index: 1; }
  .screen.active { display: flex; animation: screenIn .5s cubic-bezier(.2,.8,.2,1); }
  @keyframes screenIn { from { opacity: 0; transform: scale(.97) translateY(12px); filter: blur(6px); } }

  /* ---------- Shared pieces ---------- */
  .box { background: var(--card); border: 1px solid var(--line); border-radius: 28px; padding: 2rem; box-shadow: 0 8px 0 #0a0a0a; }
  .brand { color: #f0f0f0; font-weight: 400; font-size: 2rem; letter-spacing: -.5px; display: flex; align-items: center; gap: 12px; }
  .brand i { color: var(--accent); font-size: 1.5rem; background: #1e1e1e; padding: 8px 12px; border-radius: 40px; box-shadow: 0 0 12px rgba(100,100,255,.15); }
  .brand b { color: var(--accent); font-weight: 400; }
  .pill { font: inherit; font-size: .9rem; font-weight: 500; color: #ddd; cursor: pointer; background: #141414; border: 1px solid #2a2a2a; border-radius: 40px; padding: .5rem 1.2rem; display: inline-flex; align-items: center; gap: 8px; transition: .2s; }
  .pill i { color: var(--accent); transition: transform .25s; }
  .pill:hover { background: #222; border-color: #4a4aff; color: #fff; }
  .pill:hover i.fa-chevron-left { transform: translateX(-3px); }
  .pill:hover i.fa-exchange-alt { transform: rotate(180deg); }
  .clock-pill { color: #8a8a8a; font-size: .9rem; background: #1a1a1a; padding: .45rem 1.1rem; border-radius: 30px; border: 1px solid #2c2c2c; font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; gap: 8px; }
  .clock-pill i { color: var(--good); font-size: .5rem; animation: blink 1.6s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: .25; } }

  /* ---------- Loading ---------- */
  #loading { flex-direction: column; gap: 26px; z-index: 20; background: radial-gradient(circle at 20% 30%, #1a1a1a, #000); }
  #loading .brand { font-size: 1.5rem; animation: float 3s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-6px); } }
  .dots { display: flex; gap: 14px; padding-top: 30px; }
  .dots span { width: 18px; height: 18px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 16px rgba(100,100,255,.5); animation: bounce .9s ease-in-out infinite; }
  .dots span:nth-child(2) { animation-delay: .15s; background: #9a9aff; }
  .dots span:nth-child(3) { animation-delay: .3s; background: var(--accent-3); }
  @keyframes bounce { 0%, 100% { transform: translateY(0) scale(1,.9); opacity: .55; } 50% { transform: translateY(-28px) scale(1); opacity: 1; } }
  .bar { width: min(300px, 72vw); height: 10px; border-radius: 40px; background: #1a1a1a; border: 1px solid #2a2a2a; overflow: hidden; }
  .bar > i { display: block; position: relative; height: 100%; width: 0; background: linear-gradient(90deg, #5a5aff, var(--accent-2)); border-radius: 40px; box-shadow: 0 0 14px rgba(100,100,255,.6); transition: width .15s linear; overflow: hidden; }
  .bar > i::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,.55) 50%, transparent 70%); transform: translateX(-100%); animation: shimmer 1.1s linear infinite; }
  @keyframes shimmer { to { transform: translateX(100%); } }
  .loading-text { color: var(--muted); letter-spacing: .3px; font-size: .95rem; font-variant-numeric: tabular-nums; }

  /* ---------- Menu ---------- */
  #menu { background: rgba(0,0,0,.45); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  #menu .box { width: min(500px, 100%); background: rgba(19,19,19,.7); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); position: relative; overflow: hidden; }
  #menu .box::before { content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; background: conic-gradient(from var(--ang, 0deg), transparent 0 70%, #7c7cff 85%, transparent); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; animation: spin 6s linear infinite; pointer-events: none; }
  @property --ang { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes spin { to { --ang: 360deg; } }
  p.sub { color: var(--muted); margin: .8rem 0 1.1rem; padding-bottom: 1rem; border-bottom: 1px solid #2a2a2a; font-size: .95rem; }
  .choice { position: relative; display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; cursor: pointer; font: inherit; font-size: 1rem; font-weight: 450; color: var(--text); background: #141414; border: 1px solid #2a2a2a; border-radius: 20px; padding: .7rem 1rem; margin-top: .6rem; transition: transform .2s, border-color .2s, box-shadow .2s, background .2s; overflow: hidden; opacity: 0; animation: rise .5s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: calc(var(--i) * 70ms + 150ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .choice::before { content: ""; position: absolute; inset: 0; background: radial-gradient(180px circle at var(--mx, 50%) var(--my, 50%), rgba(124,124,255,.22), transparent 70%); opacity: 0; transition: opacity .25s; }
  .choice:hover::before { opacity: 1; }
  .choice i, .choice span { position: relative; }
  .choice i { color: var(--accent-2); background: #222; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex: none; transition: .25s; }
  .choice .go { margin-left: auto; width: auto; height: auto; background: none; color: #444; font-size: .8rem; transition: .25s; }
  .choice:hover { border-color: #4a4aff; transform: translateY(-3px); box-shadow: 0 6px 0 #0a0a0a, 0 0 22px rgba(70,70,255,.22); }
  .choice:hover i:first-child { background: #2a2a4a; color: #d0d0ff; transform: rotate(-8deg) scale(1.08); }
  .choice:hover .go { color: var(--accent-2); transform: translateX(4px); }
  .choice:active { transform: translateY(1px) scale(.99); box-shadow: none; }
  .choice.alt { background: transparent; color: var(--muted); border-style: dashed; }

  /* ---------- Tabs (from portal) ---------- */
  .tab-bar { display: flex; gap: .5rem; position: relative; padding-bottom: .7rem; border-bottom: 1px solid #262626; overflow-x: auto; scrollbar-width: none; }
  .tab-bar::-webkit-scrollbar { display: none; }
  .tab-btn { flex: none; font: inherit; font-size: .95rem; font-weight: 500; color: #888; cursor: pointer; background: #141414; border: 1px solid #2a2a2a; border-radius: 40px; padding: .55rem 1.5rem; display: flex; align-items: center; gap: 8px; letter-spacing: .3px; position: relative; z-index: 2; transition: .2s; }
  .tab-btn i { color: #6a6aff; transition: .3s; }
  .tab-btn small { font-size: .72rem; color: #666; font-weight: 400; font-variant-numeric: tabular-nums; transition: .2s; }
  .tab-btn:hover { background: #222; color: #ddd; border-color: #4a4aff; }
  .tab-btn.active { color: #f0f0ff; border-color: transparent; background: transparent; }
  .tab-btn.active i { color: var(--accent-2); }
  .tab-btn.active small { color: #aaa; }
  .tab-indicator { position: absolute; bottom: -1px; left: 0; height: 3px; width: 0; border-radius: 4px; z-index: 1; transition: left .4s cubic-bezier(.25,.8,.25,1), width .4s cubic-bezier(.25,.8,.25,1), background .3s, box-shadow .3s; background: rgba(124,124,255,.8); box-shadow: 0 0 18px rgba(124,124,255,.5); }
  .tab-indicator.green { background: rgba(0,200,80,.8); box-shadow: 0 0 18px rgba(0,200,80,.45); }
  .tab-indicator.yellow { background: rgba(255,220,0,.8); box-shadow: 0 0 18px rgba(255,220,0,.4); }
  .tab-indicator.blue { background: rgba(50,110,255,.85); box-shadow: 0 0 18px rgba(50,110,255,.5); }
  .tab-indicator.orange { background: rgba(255,165,0,.8); box-shadow: 0 0 18px rgba(255,165,0,.4); }
  .tab-indicator.purple { background: rgba(170,90,255,.85); box-shadow: 0 0 18px rgba(160,80,255,.5); }
  .tab-indicator.red { background: rgba(255,70,70,.8); box-shadow: 0 0 18px rgba(255,60,60,.4); }

  /* ---------- Dashboard ---------- */
  #dash, #times { align-items: flex-start; }
  .wrap { width: min(1000px, 100%); margin: auto; display: grid; gap: 1.2rem; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; border-bottom: 1px solid #2a2a2a; padding-bottom: 1rem; }
  .top .brand { font-size: 1.5rem; }
  .top .right { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
  .sched-title { font-size: 1rem; color: var(--accent-3); font-weight: 400; letter-spacing: .3px; display: flex; align-items: center; gap: 10px; }
  .sched-title i { color: var(--accent); }
  .lunch-box { padding: 1rem 1.4rem .9rem; border-radius: 24px; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .lunch-box .lbl { color: #8a8a8a; font-size: .9rem; display: flex; align-items: center; gap: 8px; }
  .lunch-box .lbl i { color: var(--accent); }
  .lunch-box .tab-bar { flex: 1; border-bottom: none; padding-bottom: .8rem; min-width: 260px; }
  .lunch-box { position: relative; }
  .cols { display: grid; gap: 1.2rem; }
  @media (min-width: 900px) { .cols { grid-template-columns: 1.1fr 1fr; align-items: start; } }

  .now { text-align: center; padding: 1.8rem 1.4rem 1.6rem; position: relative; overflow: hidden; }
  .now.flash::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle, rgba(124,124,255,.4), transparent 70%); animation: flash 1.2s ease-out forwards; pointer-events: none; }
  @keyframes flash { from { opacity: 1; } to { opacity: 0; } }
  .chip { display: inline-flex; align-items: center; gap: 8px; color: var(--accent-2); font-size: .85rem; background: #1a1a3a; border: 1px solid #2a2a5a; border-radius: 30px; padding: .2rem 1rem; transition: .3s; }
  .chip i { font-size: .55rem; animation: blink 1.4s infinite; }
  .chip.pass { color: var(--amber); background: #2a2214; border-color: #4a3a1a; }
  .chip.idle { color: #999; background: #1c1c1c; border-color: #2c2c2c; }
  .chip.done { color: var(--good); background: #14261c; border-color: #1f4a30; }
  .now .name { font-size: clamp(1.5rem, 5vw, 2.1rem); font-weight: 400; color: #f0f0f0; margin: .8rem 0 .15rem; letter-spacing: -.3px; }
  .now .range { color: #8a8a8a; font-size: .95rem; min-height: 1.3em; }

  .ring-wrap { position: relative; width: min(300px, 78vw); aspect-ratio: 1; margin: 1.2rem auto .8rem; --c1: #5a5aff; --c2: #c0c0ff; --glow: rgba(100,100,255,.35); }
  .ring-wrap.w10 { --c1: #ff9d2e; --c2: #ffd27a; --glow: rgba(255,165,0,.3); }
  .ring-wrap.w5 { --c1: #ff3d3d; --c2: #ff8a6a; --glow: rgba(255,80,60,.35); }
  .ring-wrap.pass { --c1: #d98a1f; --c2: #ffc766; --glow: rgba(255,180,70,.25); }
  .ring-wrap.idle { --c1: #444; --c2: #777; --glow: transparent; }
  .ring-wrap.done { --c1: #1fae63; --c2: #7dffb4; --glow: rgba(60,220,130,.3); }
  .ring-wrap svg { width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; }
  .ring-bg { fill: none; stroke: #1c1c1c; stroke-width: 10; }
  .ring-fg { fill: none; stroke: url(#rg); stroke-width: 10; stroke-linecap: round; transition: stroke-dashoffset 1s linear; filter: drop-shadow(0 0 8px var(--glow)); }
  .ring-wrap .glow { position: absolute; inset: 14%; border-radius: 50%; background: radial-gradient(circle, var(--glow), transparent 70%); animation: breathe 3.5s ease-in-out infinite; }
  @keyframes breathe { 50% { transform: scale(1.12); opacity: .6; } }
  .ring-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .timer { font-size: clamp(2.8rem, 12vw, 4.2rem); font-weight: 300; font-variant-numeric: tabular-nums; color: var(--c2); letter-spacing: -.02em; line-height: 1; transition: color .5s; }
  .ring-wrap.w5 .timer { animation: pulse 1s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .6; transform: scale(.98); } }
  .ring-center small { color: #777; font-size: .78rem; margin-top: .45rem; letter-spacing: .3px; }

  .next { color: #8a8a8a; font-size: .95rem; min-height: 1.4em; }
  .next b { color: #eee; font-weight: 500; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: 1.2rem; }
  .stat { background: #0e0e0e; border: 1px solid #222; border-radius: 18px; padding: .8rem .4rem; transition: .2s; }
  .stat:hover { border-color: #4a4aff; transform: translateY(-3px); }
  .stat b { display: block; font-size: 1.15rem; font-weight: 400; color: var(--accent-3); font-variant-numeric: tabular-nums; }
  .stat span { font-size: .72rem; color: #6a6a6a; }

  .list { padding: .5rem 0; }
  .list h3 { font-size: 1.05rem; font-weight: 400; color: var(--accent-3); padding: .8rem 1.4rem .8rem; border-bottom: 1px solid #2a2a2a; display: flex; align-items: center; gap: 10px; }
  .list h3 i { color: var(--accent); }
  .row { position: relative; display: flex; align-items: center; gap: 12px; padding: .72rem 1.4rem; border-bottom: 1px solid #1c1c1c; color: #ddd; font-size: .95rem; transition: opacity .4s, background .3s; background-image: linear-gradient(90deg, rgba(124,124,255,.2) var(--p, 0%), transparent var(--p, 0%)); animation: rowIn .45s cubic-bezier(.2,.8,.2,1) backwards; animation-delay: calc(var(--i) * 45ms); }
  @keyframes rowIn { from { opacity: 0; transform: translateX(-14px); } }
  .row:last-child { border-bottom: none; }
  .row .dot { width: 20px; text-align: center; color: #3a3a3a; font-size: .8rem; flex: none; }
  .row .nm { flex: 1; }
  .row .t { color: var(--accent); font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 500; font-size: .9rem; }
  .row .badge { font-size: .68rem; border-radius: 20px; padding: .05rem .6rem; background: #1f1f3a; color: var(--accent-2); border: 1px solid #2f2f5a; }
  .row .badge.nx { background: #1c1c1c; color: #999; border-color: #2c2c2c; }
  .row.past { opacity: .4; }
  .row.past .dot { color: var(--good); }
  .row.cur { background-color: #1a1a2a; box-shadow: inset 3px 0 0 var(--accent); }
  .row.cur .dot { color: var(--accent-2); animation: blink 1.2s infinite; }
  .row.cur .t { color: #d0d0ff; }

  /* ---------- Schedule times ---------- */
  .times-box { padding: 1.4rem; }
  .times-box .tab-bar { margin-bottom: 1.2rem; }
  .tpanel { animation: fadeUp .4s cubic-bezier(.2,.8,.2,1); }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } }
  .tpanel .row { padding: .65rem .4rem; animation-name: rowIn; }
  .tpanel .grp { color: var(--accent-2); font-size: .8rem; margin: 1rem 0 .2rem; padding-left: .4rem; }

  /* ---------- Toasts ---------- */
  #toasts { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 50; width: min(500px, calc(100vw - 24px)); pointer-events: none; }
  .toast { --c: var(--accent); position: relative; overflow: hidden; pointer-events: auto; cursor: pointer; display: flex; align-items: center; gap: 14px; text-align: left; background: rgba(19,19,19,.9); border: 1px solid var(--c); border-radius: 24px; padding: 1rem 1.3rem 1.1rem; box-shadow: 0 8px 0 rgba(0,0,0,.5), 0 0 44px color-mix(in srgb, var(--c) 35%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); animation: drop .55s cubic-bezier(.2,1.1,.3,1.2); }
  .toast.amber { --c: var(--amber); } .toast.red { --c: var(--hot); } .toast.green { --c: var(--good); }
  .toast .ic { flex: none; width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--c) 18%, #111); color: var(--c); font-size: 1.1rem; animation: ring .9s ease-in-out .3s 2; }
  @keyframes ring { 0%,100% { transform: rotate(0); } 20% { transform: rotate(-18deg); } 40% { transform: rotate(16deg); } 60% { transform: rotate(-10deg); } 80% { transform: rotate(6deg); } }
  .toast strong { display: block; font-size: 1.1rem; font-weight: 500; color: #fff; }
  .toast span { font-size: .92rem; color: #bbb; }
  .toast::after { content: ""; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--c); transform-origin: left; animation: drain 9s linear forwards; }
  @keyframes drain { to { transform: scaleX(0); } }
  .toast.out { opacity: 0; transform: translateY(-18px) scale(.96); transition: .35s; }
  @keyframes drop { from { opacity: 0; transform: translateY(-50px) scale(.9); } }

  /* ---------- Confetti ---------- */
  .confetti { position: fixed; top: -12px; width: 9px; height: 14px; z-index: 40; border-radius: 2px; pointer-events: none; animation: fall linear forwards; }
  @keyframes fall { to { transform: translateY(105vh) rotate(720deg); opacity: .8; } }

  @media (max-width: 600px) {
    .brand { font-size: 1.6rem; } .box { padding: 1.4rem; border-radius: 24px; }
    .row { padding: .65rem 1rem; } .stats { gap: .4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
</head>
<body>

<div class="bg"><i class="orb o1"></i><i class="orb o2"></i><i class="orb o3"></i><div class="grid-lines"></div></div>
<div id="toasts" aria-live="assertive"></div>

<!-- Loading -->
<section id="loading" class="screen active" aria-label="Loading">
  <div class="brand"><i class="fas fa-graduation-cap"></i><span>Raider <b>Portal</b></span></div>
  <div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="bar"><i id="barFill"></i></div>
  <div class="loading-text" id="loadText">Loading...</div>
</section>

<!-- Menu -->
<section id="menu" class="screen" aria-label="Choose a schedule">
  <div class="box">
    <h1 class="brand"><i class="fas fa-graduation-cap"></i><span>Raider <b>Portal</b></span></h1>
    <p class="sub">Middletown Area High School</p>
    <button class="choice" style="--i:0" data-s="regular"><i class="fas fa-school"></i><span>Regular Schedule Day</span><i class="fas fa-chevron-right go"></i></button>
    <button class="choice" style="--i:1" data-s="activity"><i class="fas fa-star"></i><span>Activity Schedule Day</span><i class="fas fa-chevron-right go"></i></button>
    <button class="choice" style="--i:2" data-s="delay"><i class="fas fa-hourglass-half"></i><span>2 Hour Delay Schedule Day</span><i class="fas fa-chevron-right go"></i></button>
    <button class="choice" style="--i:3" data-s="edA"><i class="fas fa-door-open"></i><span>Early Dismissal Schedule A</span><i class="fas fa-chevron-right go"></i></button>
    <button class="choice" style="--i:4" data-s="edB"><i class="fas fa-door-closed"></i><span>Early Dismissal Schedule B</span><i class="fas fa-chevron-right go"></i></button>
    <button class="choice alt" style="--i:5" id="showTimes"><i class="fas fa-calendar-alt"></i><span>Schedule Times</span><i class="fas fa-chevron-right go"></i></button>
  </div>
</section>

<!-- Dashboard -->
<section id="dash" class="screen" aria-label="Schedule countdown">
  <div class="wrap">
    <div class="top">
      <div>
        <div class="brand"><i class="fas fa-graduation-cap"></i><span>Raider <b>Portal</b></span></div>
      </div>
      <div class="right">
        <span class="clock-pill"><i class="fas fa-circle"></i><span id="liveClock">--:--:--</span></span>
        <button class="pill" id="change"><i class="fas fa-exchange-alt"></i> Change schedule</button>
      </div>
    </div>
    <div class="sched-title"><i class="fas fa-bell"></i><span id="schedTitle"></span></div>

    <div class="box lunch-box" id="lunchBox">
      <div class="lbl"><i class="fas fa-utensils"></i> Your lunch</div>
      <div class="tab-bar" id="lunchBar"></div>
    </div>

    <div class="cols">
      <div class="box now" id="nowCard">
        <span class="chip" id="chip"><i class="fas fa-circle"></i><span id="state"></span></span>
        <div class="name" id="pname"></div>
        <div class="range" id="prange"></div>
        <div class="ring-wrap" id="ring">
          <div class="glow"></div>
          <svg viewBox="0 0 260 260" aria-hidden="true">
            <defs><linearGradient id="rg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--c1)"/><stop offset="1" stop-color="var(--c2)"/></linearGradient></defs>
            <circle class="ring-bg" cx="130" cy="130" r="115"/>
            <circle class="ring-fg" id="ringFg" cx="130" cy="130" r="115"/>
          </svg>
          <div class="ring-center"><div class="timer" id="timer">--:--</div><small id="timerLbl">remaining</small></div>
        </div>
        <div class="next" id="next"></div>
        <div class="stats">
          <div class="stat"><b id="stEnds">--</b><span>ends at</span></div>
          <div class="stat"><b id="stLeft">--</b><span>periods left</span></div>
          <div class="stat"><b id="stDay">--</b><span>day complete</span></div>
        </div>
      </div>
      <div class="box list" id="listBox">
        <h3><i class="fas fa-list-ul"></i> Today's periods</h3>
        <div id="list"></div>
      </div>
    </div>
  </div>
</section>

<!-- Schedule times -->
<section id="times" class="screen" aria-label="All schedule times">
  <div class="wrap" style="width:min(700px,100%)">
    <div class="top">
      <div class="brand"><i class="fas fa-calendar-alt"></i><span>Schedule <b>Times</b></span></div>
      <button class="pill" id="backMenu"><i class="fas fa-chevron-left"></i> Back</button>
    </div>
    <div class="box times-box">
      <div class="tab-bar" id="timesBar"></div>
      <div id="timesBody"></div>
    </div>
  </div>
</section>

<script>
/* ================= DATA ================= */
const L = (a, b, c) => ({ A: a, B: b, C: c });
const SCHEDULES = {
  regular: { short: 'Regular', color: 'purple', title: 'Regular Day Schedule', periods: [
    ['Period 1','7:35','8:24'], ['Period 2','8:27','9:08'], ['Period 3','9:11','9:52'],
    ['FLEX','9:55','10:30'],
    ['Period 4', L(['10:33','11:03'], ['11:03','11:33'], ['11:33','12:03'])],
    ['Period 5','12:06','12:47'], ['Period 6','12:50','1:31'], ['Period 7','1:34','2:15'] ] },
  activity: { short: 'Activity', color: 'orange', title: 'Activity Day Schedule', periods: [
    ['Period 1','7:35','8:16'], ['Period 2','8:19','8:55'], ['Period 3','8:58','9:34'],
    ['FLEX','9:37','10:13'], ['Period 5','10:16','10:52'],
    ['Period 4', L(['10:55','11:25'], ['11:25','11:55'], ['11:55','12:25'])],
    ['Period 6','12:28','1:04'], ['Period 7','1:07','1:43'], ['Activity','1:46','2:15'] ] },
  delay: { short: '2 Hour Delay', color: 'yellow', title: '2 Hour Delay Schedule', periods: [
    ['Period 1','9:35','10:07'], ['Period 2','10:10','10:38'], ['Period 3','10:41','11:09'],
    ['Period 4', L(['11:12','11:42'], ['11:42','12:12'], ['12:12','12:42'])],
    ['Period 5','12:45','1:13'], ['Period 6','1:16','1:44'], ['Period 7','1:47','2:15'] ] },
  edA: { short: 'Early Dismissal A', color: 'green', title: 'Early Dismissal Schedule A', periods: [
    ['Period 1','7:35','8:10'], ['Period 2','8:13','8:48'], ['Period 3','8:51','9:26'],
    ['Period 4', L(['9:29','9:59'], ['9:59','10:29'], ['10:29','11:00'])] ] },
  edB: { short: 'Early Dismissal B', color: 'blue', title: 'Early Dismissal Schedule B', periods: [
    ['Period 1','7:35','7:41'], ['Period 5','7:44','8:17'], ['Period 6','8:20','8:53'], ['Period 7','8:56','9:29'],
    ['Period 4', L(['9:30','10:00'], ['10:00','10:30'], ['10:30','11:00'])] ] }
};
const LUNCH_COLORS = { A: 'green', B: 'yellow', C: 'blue' };

/* ================= HELPERS ================= */
const $ = id => document.getElementById(id);
const pad = n => String(n).padStart(2, '0');
const toSec = s => { let [h, m] = s.split(':').map(Number); if (h < 7) h += 12; return h * 3600 + m * 60; };
const fmtClock = s => { const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60); return (h > 12 ? h - 12 : h) + ':' + pad(m); };
const fmtCount = s => { s = Math.max(0, Math.ceil(s)); const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; return h ? `${h}:${pad(m)}:${pad(x)}` : `${pad(m)}:${pad(x)}`; };
const isLunch = p => typeof p[1] === 'object';
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

function build(key, lunch) {
  return SCHEDULES[key].periods.map(p => {
    if (isLunch(p)) { const [a, b] = p[1][lunch]; return { name: `${p[0]} · Lunch ${lunch}`, start: toSec(a), end: toSec(b) }; }
    return { name: p[0], start: toSec(p[1]), end: toSec(p[2]) };
  });
}

/* Test any time of day: add ?time=8:15 to the URL (clock then runs live from there) */
const tp = new URLSearchParams(location.search).get('time');
let offsetMs = 0;
if (tp && /^\d{1,2}:\d{2}$/.test(tp)) {
  const n = new Date();
  offsetMs = (toSec(tp) - (n.getHours() * 3600 + n.getMinutes() * 60 + n.getSeconds())) * 1000;
}
const nowDate = () => new Date(Date.now() + offsetMs);
const nowSec = () => { const d = nowDate(); return d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds() + d.getMilliseconds() / 1000; };

function show(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.toggle('active', s.id === id));
  requestAnimationFrame(() => document.querySelectorAll('.screen.active .tab-bar').forEach(moveInd));
}

/* ================= TABS ================= */
function moveInd(bar) {
  const a = bar.querySelector('.tab-btn.active'), ind = bar.querySelector('.tab-indicator');
  if (!a || !ind) return;
  ind.style.left = a.offsetLeft + 'px'; ind.style.width = a.offsetWidth + 'px';
  ind.className = 'tab-indicator ' + (a.dataset.color || '');
  a.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduced ? 'auto' : 'smooth' });
}
function setActive(bar, btn) { bar.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b === btn)); moveInd(bar); }
addEventListener('resize', () => document.querySelectorAll('.screen.active .tab-bar').forEach(moveInd));

/* ================= LOADING ================= */
function runLoading(ms, done) {
  show('loading');
  const fill = $('barFill'), txt = $('loadText'); fill.style.width = '0%';
  const t0 = performance.now();
  (function step(t) {
    const raw = Math.min(1, (t - t0) / ms), p = 1 - Math.pow(1 - raw, 2);
    fill.style.width = (p * 100) + '%';
    txt.textContent = `Loading... ${Math.round(p * 100)}%`;
    raw < 1 ? requestAnimationFrame(step) : setTimeout(done, 250);
  })(t0);
}

/* ================= SOUND, TOASTS, CONFETTI ================= */
let audioCtx;
function chime(freqs = [880, 1175]) {
  try {
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    freqs.forEach((f, i) => {
      const o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.type = 'sine'; o.frequency.value = f; o.connect(g); g.connect(audioCtx.destination);
      const t = audioCtx.currentTime + i * 0.18;
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.16, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.4);
      o.start(t); o.stop(t + 0.45);
    });
  } catch (e) {}
}
function toast(kind, icon, title, body, tones) {
  const box = $('toasts'); box.innerHTML = '';
  const el = document.createElement('div'); el.className = 'toast ' + kind; el.setAttribute('role', 'alert');
  el.innerHTML = `<div class="ic"><i class="fas ${icon}"></i></div><div><strong></strong><span></span></div>`;
  el.querySelector('strong').textContent = title; el.querySelector('span').textContent = body;
  const close = () => { el.classList.add('out'); setTimeout(() => el.remove(), 400); };
  el.addEventListener('click', close); setTimeout(close, 9000);
  box.appendChild(el); chime(tones);
}
function confetti() {
  if (reduced) return;
  const cols = ['#7c7cff', '#b0b0ff', '#3ddc84', '#ffb44a', '#ff5a4a', '#4aa8ff'];
  for (let i = 0; i < 70; i++) {
    const c = document.createElement('i'); c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw'; c.style.background = cols[i % cols.length];
    c.style.animationDuration = (2.2 + Math.random() * 2.4) + 's'; c.style.animationDelay = Math.random() * .8 + 's';
    c.style.transform = `rotate(${Math.random() * 360}deg)`;
    document.body.appendChild(c); setTimeout(() => c.remove(), 6000);
  }
}

/* ================= APP STATE ================= */
let curKey = null, lunch = 'A', periods = [], fired = new Set(), prevIdx = -2, timerId = null, lastTimerText = '';
try { lunch = localStorage.getItem('lunch') || 'A'; } catch (e) {}
const C = 2 * Math.PI * 115;
$('ringFg').style.strokeDasharray = C; $('ringFg').style.strokeDashoffset = C;

function startSchedule(key) {
  curKey = key; fired = new Set(); prevIdx = -2;
  $('schedTitle').textContent = SCHEDULES[key].title;
  const lp = SCHEDULES[key].periods.find(isLunch);
  $('lunchBar').innerHTML = ['A', 'B', 'C'].map(l =>
    `<button class="tab-btn${l === lunch ? ' active' : ''}" data-l="${l}" data-color="${LUNCH_COLORS[l]}"><i class="fas fa-utensils"></i>Lunch ${l}<small>${lp[1][l][0]}–${lp[1][l][1]}</small></button>`
  ).join('') + '<div class="tab-indicator"></div>';
  periods = build(key, lunch); renderList();
  show('dash'); clearInterval(timerId); timerId = setInterval(tick, 250); tick();
}
$('lunchBar').addEventListener('click', e => {
  const b = e.target.closest('.tab-btn'); if (!b) return;
  lunch = b.dataset.l; try { localStorage.setItem('lunch', lunch); } catch (x) {}
  setActive($('lunchBar'), b); periods = build(curKey, lunch); renderList(); tick();
});

function renderList() {
  $('list').innerHTML = periods.map((p, i) =>
    `<div class="row" style="--i:${i}"><span class="dot"><i class="fas fa-circle"></i></span><span class="nm">${p.name}</span><span class="badge" hidden></span><span class="t">${fmtClock(p.start)} – ${fmtClock(p.end)}</span></div>`).join('');
}

function setRing(frac, cls) {
  $('ringFg').style.strokeDashoffset = C * (1 - Math.min(1, Math.max(0, frac)));
  $('ring').className = 'ring-wrap ' + cls;
}
function setChip(cls, text) { $('chip').className = 'chip ' + cls; $('state').textContent = text; }

function tick() {
  if (!periods.length) return;
  const d = nowDate(); $('liveClock').textContent = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', second: '2-digit' });
  const t = nowSec();
  const idx = periods.findIndex(p => t >= p.start && t < p.end);
  const first = periods[0], last = periods[periods.length - 1];

  // A period just ended -> announce the next one
  if (prevIdx >= 0 && idx !== prevIdx) {
    const ended = periods[prevIdx], nxt = periods[prevIdx + 1];
    $('nowCard').classList.remove('flash'); void $('nowCard').offsetWidth; $('nowCard').classList.add('flash');
    if (nxt) toast('', 'fa-forward', `${ended.name} has ended`, `Next up: ${nxt.name} at ${fmtClock(nxt.start)}`, [660, 880, 1175]);
    else { toast('green', 'fa-flag-checkered', `${ended.name} has ended`, 'That is the end of the school day!', [660, 880, 1320]); confetti(); }
  }
  prevIdx = idx;

  let timerText, lbl = 'remaining', ends = '--', docTitle = 'Raider Portal';
  const dayFrac = Math.min(1, Math.max(0, (t - first.start) / (last.end - first.start)));

  if (idx >= 0) {
    const p = periods[idx], left = p.end - t, dur = p.end - p.start, nx = periods[idx + 1];
    setChip('', 'In session'); $('pname').textContent = p.name; $('prange').textContent = `${fmtClock(p.start)} – ${fmtClock(p.end)}`;
    timerText = fmtCount(left); ends = fmtClock(p.end);
    setRing(1 - (t - p.start) / dur, left <= 300 ? 'w5' : left <= 600 ? 'w10' : '');
    $('next').innerHTML = nx ? `Next: <b>${nx.name}</b> at ${fmtClock(nx.start)}` : 'This is the last period of the day.';
    docTitle = `${timerText} · ${p.name}`;

    // Reminders: only the most urgent applicable one; skipped for periods too short
    const k5 = `${p.start}-5`, k10 = `${p.start}-10`;
    if (left <= 300 && dur > 300) {
      if (!fired.has(k5)) { fired.add(k5); fired.add(k10); toast('red', 'fa-bell', '5 minutes left', `${p.name} ends at ${fmtClock(p.end)}.`, [988, 988, 1318]); }
    } else if (left <= 600 && left > 300 && dur > 600) {
      if (!fired.has(k10)) { fired.add(k10); toast('amber', 'fa-hourglass-half', '10 minutes left', `${p.name} ends at ${fmtClock(p.end)}.`, [784, 988]); }
    }
  } else if (t < first.start) {
    setChip('idle', 'School starts soon'); $('pname').textContent = first.name; $('prange').textContent = `${fmtClock(first.start)} – ${fmtClock(first.end)}`;
    timerText = fmtCount(first.start - t); lbl = 'until first bell'; ends = fmtClock(first.start);
    setRing(0, 'idle'); $('next').textContent = '';
  } else if (t >= last.end) {
    setChip('done', 'Day complete'); $('pname').textContent = 'School is out for today'; $('prange').textContent = '';
    timerText = '0:00'; lbl = 'see you tomorrow'; ends = fmtClock(last.end);
    setRing(1, 'done'); $('next').textContent = '';
  } else {
    const n = periods.find(p => p.start > t), prev = periods[periods.indexOf(n) - 1], gap = n.start - prev.end;
    setChip('pass', 'Passing time'); $('pname').textContent = `Next: ${n.name}`; $('prange').textContent = `${fmtClock(n.start)} – ${fmtClock(n.end)}`;
    timerText = fmtCount(n.start - t); lbl = 'until next period'; ends = fmtClock(n.start);
    setRing(1 - (t - prev.end) / gap, 'pass'); $('next').textContent = '';
    docTitle = `${timerText} · ${n.name}`;
  }

  const tm = $('timer');
  if (timerText !== lastTimerText) {
    tm.textContent = timerText; lastTimerText = timerText;
    if (!reduced && tm.animate) tm.animate([{ transform: 'scale(1.045)' }, { transform: 'scale(1)' }], { duration: 260, easing: 'ease-out' });
  }
  $('timerLbl').textContent = lbl; $('stEnds').textContent = ends;
  $('stLeft').textContent = periods.filter(p => p.end > t).length;
  $('stDay').textContent = Math.round(dayFrac * 100) + '%';
  document.title = docTitle;

  const next = idx >= 0 ? idx + 1 : periods.findIndex(p => p.start > t);
  document.querySelectorAll('#list .row').forEach((r, i) => {
    const p = periods[i], cur = i === idx;
    r.classList.toggle('cur', cur); r.classList.toggle('past', p.end <= t);
    r.style.setProperty('--p', cur ? ((t - p.start) / (p.end - p.start) * 100) + '%' : '0%');
    const dot = r.querySelector('.dot i'), badge = r.querySelector('.badge');
    dot.className = 'fas ' + (p.end <= t ? 'fa-check' : cur ? 'fa-circle' : 'fa-circle');
    badge.hidden = !(cur || i === next); badge.textContent = cur ? 'Now' : 'Next'; badge.className = 'badge' + (cur ? '' : ' nx');
  });
}

/* ================= SCHEDULE TIMES ================= */
function buildTimes() {
  const bar = $('timesBar');
  bar.innerHTML = Object.entries(SCHEDULES).map(([k, s], i) =>
    `<button class="tab-btn${i === 0 ? ' active' : ''}" data-k="${k}" data-color="${s.color}">${s.short}</button>`).join('') + '<div class="tab-indicator"></div>';
  renderTimes('regular');
}
function renderTimes(key) {
  const rows = [];
  SCHEDULES[key].periods.forEach(p => {
    if (isLunch(p)) ['A', 'B', 'C'].forEach(l => rows.push([`${p[0]} · Lunch ${l}`, ...p[1][l]]));
    else rows.push(p);
  });
  $('timesBody').innerHTML = `<div class="tpanel"><div class="grp">${SCHEDULES[key].title}</div>` +
    rows.map((r, i) => `<div class="row" style="--i:${i}"><span class="nm">${r[0]}</span><span class="t">${r[1]} – ${r[2]}</span></div>`).join('') + '</div>';
}
$('timesBar').addEventListener('click', e => {
  const b = e.target.closest('.tab-btn'); if (!b) return;
  setActive($('timesBar'), b); renderTimes(b.dataset.k);
});

/* ================= EVENTS ================= */
function unlockAudio() { try { audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)(); audioCtx.resume(); } catch (e) {} }
document.querySelectorAll('.choice[data-s]').forEach(b =>
  b.addEventListener('click', () => { unlockAudio(); runLoading(1300, () => startSchedule(b.dataset.s)); }));
document.querySelectorAll('.choice').forEach(b => b.addEventListener('pointermove', e => {
  const r = b.getBoundingClientRect(); b.style.setProperty('--mx', (e.clientX - r.left) + 'px'); b.style.setProperty('--my', (e.clientY - r.top) + 'px');
}));
$('showTimes').addEventListener('click', () => { buildTimes(); show('times'); });
$('backMenu').addEventListener('click', () => show('menu'));
$('change').addEventListener('click', () => { clearInterval(timerId); document.title = 'Raider Portal'; show('menu'); });

/* ================= BOOT ================= */
runLoading(2800, () => show('menu'));
</script>
</body>
</html>
