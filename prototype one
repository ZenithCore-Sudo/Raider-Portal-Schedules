<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bell Schedule</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<style>
  :root {
    --bg: #0b0b0b;
    --card: #131313;
    --card-2: #0e0e0e;
    --line: #282828;
    --accent: #7c7cff;
    --accent-2: #b0b0ff;
    --accent-3: #c0c0ff;
    --text: #eaeaea;
    --muted: #888;
    --hot: #ff6a4a;
    color-scheme: dark;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Roboto, system-ui, -apple-system, sans-serif; }
  html, body { height: 100%; }
  body {
    background-color: var(--bg);
    background: radial-gradient(circle at 20% 30%, #1a1a1a, #000000);
    background-attachment: fixed;
    color: var(--text);
    overflow-x: hidden;
  }
  .screen { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; padding: 2rem 1.5rem; overflow-y: auto; }
  .screen.active { display: flex; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* ---------- Loading ---------- */
  #loading { flex-direction: column; gap: 28px; z-index: 20; background: radial-gradient(circle at 20% 30%, #1a1a1a, #000); }
  .dots { display: flex; gap: 14px; }
  .dots span {
    width: 18px; height: 18px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 14px rgba(100,100,255,.45);
    animation: bounce .9s ease-in-out infinite;
  }
  .dots span:nth-child(2) { animation-delay: .15s; }
  .dots span:nth-child(3) { animation-delay: .3s; }
  @keyframes bounce { 0%, 100% { transform: translateY(0); opacity: .55; } 50% { transform: translateY(-26px); opacity: 1; } }
  .bar { width: min(280px, 70vw); height: 8px; border-radius: 40px; background: #1a1a1a; border: 1px solid #2a2a2a; overflow: hidden; }
  .bar > i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #5a5aff, var(--accent-2)); border-radius: 40px; box-shadow: 0 0 12px rgba(100,100,255,.5); transition: width .15s linear; }
  .loading-text { color: var(--muted); letter-spacing: .3px; font-size: .95rem; }

  /* ---------- Cards / boxes ---------- */
  .box {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 2rem;
    box-shadow: 0 8px 0 #0a0a0a;
  }
  .brand {
    color: #f0f0f0; font-weight: 400; font-size: 2rem; letter-spacing: -.5px;
    display: flex; align-items: center; gap: 12px;
  }
  .brand i {
    color: var(--accent); font-size: 1.6rem; background: #1e1e1e;
    padding: 8px 12px; border-radius: 40px; box-shadow: 0 0 12px rgba(100,100,255,.15);
  }
  .brand b { color: var(--accent); font-weight: 400; }

  /* ---------- Menu overlay ---------- */
  #menu { background: rgba(0,0,0,.5); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  #menu .box {
    width: min(480px, 100%);
    background: rgba(19,19,19,.72);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  }
  #menu .brand { margin-bottom: .8rem; }
  p.sub { color: var(--muted); margin-bottom: 1.2rem; padding-bottom: 1rem; border-bottom: 1px solid #2a2a2a; font-size: .95rem; }
  .choice {
    display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; cursor: pointer;
    font: inherit; font-size: 1rem; font-weight: 450; color: var(--text);
    background: #141414; border: 1px solid #2a2a2a; border-radius: 20px;
    padding: .7rem 1rem; margin-top: .6rem;
    transition: all .2s ease;
  }
  .choice i {
    color: var(--accent-2); background: #222; width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; font-size: 1rem; flex: none; transition: .2s;
  }
  .choice:hover { background: #1f1f1f; border-color: #4a4aff; transform: translateY(-3px); box-shadow: 0 6px 0 #0a0a0a, 0 0 20px rgba(70,70,255,.2); }
  .choice:hover i { background: #2a2a4a; color: #d0d0ff; }
  .choice:active { transform: translateY(1px); box-shadow: none; }
  .choice.alt { background: transparent; color: var(--muted); border-style: dashed; }

  /* ---------- Dashboard ---------- */
  #dash, #times { align-items: flex-start; }
  .wrap, .times-wrap { width: min(620px, 100%); margin: auto; display: grid; gap: 1.2rem; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; border-bottom: 1px solid #2a2a2a; padding-bottom: 1rem; }
  .top h2 { font-size: 1.1rem; font-weight: 400; color: var(--accent-3); letter-spacing: .3px; }
  .pill {
    font: inherit; font-size: .9rem; font-weight: 500; color: #ddd; cursor: pointer;
    background: #141414; border: 1px solid #2a2a2a; border-radius: 40px; padding: .5rem 1.2rem;
    display: inline-flex; align-items: center; gap: 8px; transition: .2s;
  }
  .pill i { color: var(--accent); }
  .pill:hover { background: #222; border-color: #4a4aff; color: #fff; }

  .now { text-align: center; padding: 2.2rem 1.5rem; }
  .now .state {
    display: inline-block; color: var(--accent-2); font-size: .85rem; letter-spacing: .3px;
    background: #1a1a3a; border: 1px solid #2a2a5a; border-radius: 30px; padding: .15rem 1rem;
  }
  .now .name { font-size: clamp(1.6rem, 6vw, 2.2rem); font-weight: 400; color: #f0f0f0; margin: .9rem 0 .2rem; letter-spacing: -.3px; }
  .now .range { color: #8a8a8a; font-size: .95rem; }
  .timer {
    font-size: clamp(3.4rem, 15vw, 5.5rem); font-weight: 300; font-variant-numeric: tabular-nums;
    color: var(--accent-2); text-shadow: 0 0 30px rgba(100,100,255,.35);
    line-height: 1.1; margin: 1.1rem 0 1rem; letter-spacing: -.02em;
  }
  .timer.warn { color: var(--hot); text-shadow: 0 0 30px rgba(255,106,74,.3); animation: pulse 1s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .55; } }
  .prog { height: 8px; border-radius: 40px; background: #1a1a1a; border: 1px solid #2a2a2a; overflow: hidden; }
  .prog i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #5a5aff, var(--accent-2)); border-radius: 40px; transition: width .4s linear; }
  .next { margin-top: 1rem; font-size: .95rem; color: #8a8a8a; }
  .next b { color: #eee; font-weight: 500; }

  .lunch { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; font-size: .9rem; color: #8a8a8a; }
  .lunch button {
    font: inherit; font-weight: 500; width: 46px; height: 40px; border-radius: 40px; cursor: pointer;
    background: #141414; color: #ddd; border: 1px solid #2a2a2a; transition: .2s;
  }
  .lunch button:hover { border-color: #4a4aff; }
  .lunch button[aria-pressed="true"] { background: #2a2a4a; color: #fff; border-color: #5a5aff; }

  .list { padding: .5rem 0; border-radius: 28px; }
  .row { display: flex; justify-content: space-between; gap: 12px; padding: .7rem 1.4rem; border-bottom: 1px solid #1c1c1c; color: #ddd; font-size: .95rem; transition: .15s; }
  .row:last-child { border-bottom: none; }
  .row .t { color: var(--accent); font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 500; }
  .row.past { opacity: .38; }
  .row.cur { background: #1a1a2a; box-shadow: inset 3px 0 0 var(--accent); }
  .row.cur .t { color: #d0d0ff; }

  /* ---------- Schedule times ---------- */
  .times-wrap .box { padding: 1.4rem 0 .6rem; }
  .times-wrap h3 { font-size: 1.1rem; font-weight: 400; color: var(--accent-2); padding: 0 1.4rem .7rem; margin-bottom: .2rem; border-bottom: 1px solid #2a2a2a; }

  /* ---------- Reminder toast ---------- */
  #toasts { position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 50; width: min(480px, calc(100vw - 24px)); pointer-events: none; }
  .toast {
    pointer-events: auto; text-align: center;
    background: rgba(19,19,19,.88); border: 1px solid #4a4aff; border-radius: 24px;
    padding: 1rem 1.4rem; box-shadow: 0 8px 0 rgba(0,0,0,.5), 0 0 40px rgba(70,70,255,.25);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    animation: drop .35s cubic-bezier(.2,.9,.3,1.2);
  }
  .toast strong { display: block; font-size: 1.1rem; font-weight: 500; color: var(--accent-3); margin-bottom: 2px; }
  .toast span { font-size: .92rem; color: #ddd; }
  .toast.out { opacity: 0; transform: translateY(-14px); transition: .35s; }
  @keyframes drop { from { opacity: 0; transform: translateY(-30px); } }

  @media (max-width: 600px) {
    .brand { font-size: 1.6rem; }
    .box { padding: 1.4rem; border-radius: 24px; }
    .row { padding: .65rem 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dots span, .timer.warn, .toast { animation: none; }
    .bar > i, .prog i, .choice { transition: none; }
  }
</style>
</head>
<body>

<div id="toasts" aria-live="assertive"></div>

<!-- Loading -->
<section id="loading" class="screen active" aria-label="Loading">
  <div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="bar"><i id="barFill"></i></div>
  <div class="loading-text">Loading...</div>
</section>

<!-- Menu -->
<section id="menu" class="screen" aria-label="Choose a schedule">
  <div class="box">
    <h1 class="brand"><i class="fas fa-graduation-cap"></i><span>Raider<b>Hub</b></span></h1>
    <p class="sub">Pick today's schedule and the countdown starts.</p>
    <button class="choice" data-s="regular"><i class="fas fa-school"></i><span>Regular Schedule Day</span></button>
    <button class="choice" data-s="activity"><i class="fas fa-star"></i><span>Activity Schedule Day</span></button>
    <button class="choice" data-s="delay"><i class="fas fa-hourglass-half"></i><span>2 Hour Delay Schedule Day</span></button>
    <button class="choice" data-s="edA"><i class="fas fa-door-open"></i><span>Early Dismissal Schedule A</span></button>
    <button class="choice" data-s="edB"><i class="fas fa-door-closed"></i><span>Early Dismissal Schedule B</span></button>
    <button class="choice alt" id="showTimes"><i class="fas fa-calendar-alt"></i><span>Schedule Times</span></button>
  </div>
</section>

<!-- Dashboard -->
<section id="dash" class="screen" aria-label="Schedule countdown">
  <div class="wrap">
    <div class="top">
      <h2 id="schedTitle"></h2>
      <button class="pill" id="change"><i class="fas fa-exchange-alt"></i> Change schedule</button>
    </div>
    <div class="box now">
      <div class="state" id="state"></div>
      <div class="name" id="pname"></div>
      <div class="range" id="prange"></div>
      <div class="timer" id="timer">--:--</div>
      <div class="prog"><i id="progFill"></i></div>
      <div class="next" id="next"></div>
    </div>
    <div class="lunch" id="lunchRow">
      <i class="fas fa-utensils" style="color:#7c7cff"></i> Your lunch:
      <button data-l="A" aria-pressed="true">A</button>
      <button data-l="B" aria-pressed="false">B</button>
      <button data-l="C" aria-pressed="false">C</button>
    </div>
    <div class="box list" id="list"></div>
  </div>
</section>

<!-- Schedule times -->
<section id="times" class="screen" aria-label="All schedule times">
  <div class="times-wrap">
    <div class="top"><h2>Schedule Times</h2><button class="pill" id="backMenu"><i class="fas fa-chevron-left"></i> Back</button></div>
    <div id="timesBody" style="display:grid;gap:16px"></div>
  </div>
</section>

<script>
/* ============ DATA ============ */
// Lunch periods: ['Period 4', {A:[start,end], B:[...], C:[...]}]
const L = (a, b, c) => ({ A: a, B: b, C: c });
const SCHEDULES = {
  regular: { title: 'Regular Day Schedule', periods: [
    ['Period 1','7:35','8:24'], ['Period 2','8:27','9:08'], ['Period 3','9:11','9:52'],
    ['FLEX','9:55','10:30'],
    ['Period 4', L(['10:33','11:03'], ['11:03','11:33'], ['11:33','12:03'])],
    ['Period 5','12:06','12:47'], ['Period 6','12:50','1:31'], ['Period 7','1:34','2:15'] ] },
  activity: { title: 'Activity Day Schedule', periods: [
    ['Period 1','7:35','8:16'], ['Period 2','8:19','8:55'], ['Period 3','8:58','9:34'],
    ['FLEX','9:37','10:13'], ['Period 5','10:16','10:52'],
    ['Period 4', L(['10:55','11:25'], ['11:25','11:55'], ['11:55','12:25'])],
    ['Period 6','12:28','1:04'], ['Period 7','1:07','1:43'], ['Activity','1:46','2:15'] ] },
  delay: { title: '2 Hour Delay Schedule', periods: [
    ['Period 1','9:35','10:07'], ['Period 2','10:10','10:38'], ['Period 3','10:41','11:09'],
    ['Period 4', L(['11:12','11:42'], ['11:42','12:12'], ['12:12','12:42'])],
    ['Period 5','12:45','1:13'], ['Period 6','1:16','1:44'], ['Period 7','1:47','2:15'] ] },
  edA: { title: 'Early Dismissal Schedule A', periods: [
    ['Period 1','7:35','8:10'], ['Period 2','8:13','8:48'], ['Period 3','8:51','9:26'],
    ['Period 4', L(['9:29','9:59'], ['9:59','10:29'], ['10:29','11:00'])] ] },
  edB: { title: 'Early Dismissal Schedule B', periods: [
    ['Period 1','7:35','7:41'], ['Period 5','7:44','8:17'], ['Period 6','8:20','8:53'], ['Period 7','8:56','9:29'],
    ['Period 4', L(['9:30','10:00'], ['10:00','10:30'], ['10:30','11:00'])] ] }
};

/* ============ HELPERS ============ */
const $ = id => document.getElementById(id);
const toSec = s => { let [h, m] = s.split(':').map(Number); if (h < 7) h += 12; return h * 3600 + m * 60; };
const pad = n => String(n).padStart(2, '0');
const fmtClock = s => { const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60); return (h > 12 ? h - 12 : h) + ':' + pad(m); };
const fmtCount = s => {
  s = Math.max(0, Math.ceil(s));
  const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), sec = s % 60;
  return h ? `${h}:${pad(m)}:${pad(sec)}` : `${pad(m)}:${pad(sec)}`;
};
const hasLunch = key => SCHEDULES[key].periods.some(p => !Array.isArray(p[1]) && typeof p[1] === 'object');

function build(key, lunch) {
  return SCHEDULES[key].periods.map(p => {
    if (typeof p[1] === 'object') {
      const [a, b] = p[1][lunch];
      return { name: `${p[0]} · Lunch ${lunch}`, start: toSec(a), end: toSec(b) };
    }
    return { name: p[0], start: toSec(p[1]), end: toSec(p[2]) };
  });
}

/* Test the app any time of day: add ?time=8:15 to the URL (clock then runs live from there). */
const testParam = new URLSearchParams(location.search).get('time');
let offsetMs = 0;
if (testParam && /^\d{1,2}:\d{2}$/.test(testParam)) {
  const n = new Date(), t = toSec(testParam.replace(/^(\d{1,2}):/, (m, h) => (+h < 7 ? +h + 12 : h) + ':'));
  offsetMs = (t - (n.getHours() * 3600 + n.getMinutes() * 60 + n.getSeconds())) * 1000;
}
const nowSec = () => { const d = new Date(Date.now() + offsetMs); return d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds() + d.getMilliseconds() / 1000; };

function show(id) { document.querySelectorAll('.screen').forEach(s => s.classList.toggle('active', s.id === id)); }

/* ============ LOADING ============ */
function runLoading(ms, done) {
  show('loading');
  const fill = $('barFill'); fill.style.width = '0%';
  const t0 = performance.now();
  (function step(t) {
    const p = Math.min(1, (t - t0) / ms);
    fill.style.width = (p * 100) + '%';
    p < 1 ? requestAnimationFrame(step) : setTimeout(done, 200);
  })(t0);
}

/* ============ TOASTS + CHIME ============ */
let audioCtx;
function chime() {
  try {
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    [880, 1175].forEach((f, i) => {
      const o = audioCtx.createOscillator(), g = audioCtx.createGain();
      o.frequency.value = f; o.connect(g); g.connect(audioCtx.destination);
      const t = audioCtx.currentTime + i * 0.18;
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.15, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, t + 0.35);
      o.start(t); o.stop(t + 0.4);
    });
  } catch (e) {}
}
function toast(title, body) {
  const box = $('toasts'); box.innerHTML = '';
  const el = document.createElement('div'); el.className = 'toast'; el.setAttribute('role', 'alert');
  el.innerHTML = `<strong></strong><span></span>`;
  el.children[0].textContent = title; el.children[1].textContent = body;
  box.appendChild(el); chime();
  setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 400); }, 9000);
}

/* ============ APP STATE ============ */
let curKey = null, lunch = 'A', periods = [], fired = new Set(), prevIdx = -2, timerId = null;
try { lunch = localStorage.getItem('lunch') || 'A'; } catch (e) {}

function startSchedule(key) {
  curKey = key; fired = new Set(); prevIdx = -2;
  $('schedTitle').textContent = SCHEDULES[key].title;
  $('lunchRow').style.display = hasLunch(key) ? 'flex' : 'none';
  setLunch(lunch, true);
  show('dash');
  clearInterval(timerId); timerId = setInterval(tick, 500); tick();
}
function setLunch(l, silent) {
  lunch = l;
  try { localStorage.setItem('lunch', l); } catch (e) {}
  document.querySelectorAll('#lunchRow button').forEach(b => b.setAttribute('aria-pressed', b.dataset.l === l));
  periods = build(curKey, l);
  renderList();
  if (!silent) tick();
}
function renderList() {
  $('list').innerHTML = periods.map((p, i) =>
    `<div class="row" data-i="${i}"><span>${p.name}</span><span class="t">${fmtClock(p.start)} – ${fmtClock(p.end)}</span></div>`).join('');
}

function tick() {
  if (!periods.length) return;
  const t = nowSec();
  const idx = periods.findIndex(p => t >= p.start && t < p.end);
  const first = periods[0], last = periods[periods.length - 1];

  // Period just ended -> announce what's next
  if (prevIdx >= 0 && idx !== prevIdx) {
    const ended = periods[prevIdx], nxt = periods[prevIdx + 1];
    if (nxt) toast(`${ended.name} has ended`, `Next up: ${nxt.name} at ${fmtClock(nxt.start)}`);
    else toast(`${ended.name} has ended`, 'That is the end of the school day.');
  }
  prevIdx = idx;

  const timer = $('timer'), prog = $('progFill');
  timer.classList.remove('warn');

  if (idx >= 0) {
    const p = periods[idx], left = p.end - t, dur = p.end - p.start;
    $('state').textContent = 'Now';
    $('pname').textContent = p.name;
    $('prange').textContent = `${fmtClock(p.start)} – ${fmtClock(p.end)}`;
    timer.textContent = fmtCount(left);
    prog.style.width = ((t - p.start) / dur * 100) + '%';
    if (left <= 300) timer.classList.add('warn');
    const n = periods[idx + 1];
    $('next').innerHTML = n ? `Next: <b>${n.name}</b> at ${fmtClock(n.start)}` : 'This is the last period of the day.';

    // Reminders (only the most urgent one that applies; never for periods too short)
    const k5 = `${p.start}-5`, k10 = `${p.start}-10`;
    if (left <= 300 && dur > 300) {
      if (!fired.has(k5)) { fired.add(k5); fired.add(k10); toast('5 minutes left', `${p.name} ends at ${fmtClock(p.end)}.`); }
    } else if (left <= 600 && left > 300 && dur > 600) {
      if (!fired.has(k10)) { fired.add(k10); toast('10 minutes left', `${p.name} ends at ${fmtClock(p.end)}.`); }
    }
    document.title = `${fmtCount(left)} · ${p.name}`;
  } else if (t < first.start) {
    $('state').textContent = 'School starts in';
    $('pname').textContent = first.name;
    $('prange').textContent = `${fmtClock(first.start)} – ${fmtClock(first.end)}`;
    timer.textContent = fmtCount(first.start - t); prog.style.width = '0%';
    $('next').textContent = '';
    document.title = 'Bell Schedule';
  } else if (t >= last.end) {
    $('state').textContent = 'Done';
    $('pname').textContent = 'School is out for today';
    $('prange').textContent = '';
    timer.textContent = '0:00'; prog.style.width = '100%';
    $('next').textContent = '';
    document.title = 'Bell Schedule';
  } else {
    const n = periods.find(p => p.start > t);
    $('state').textContent = 'Passing time';
    $('pname').textContent = `Next: ${n.name}`;
    $('prange').textContent = `${fmtClock(n.start)} – ${fmtClock(n.end)}`;
    timer.textContent = fmtCount(n.start - t); prog.style.width = '100%';
    $('next').textContent = '';
    document.title = `${fmtCount(n.start - t)} · ${n.name}`;
  }

  document.querySelectorAll('#list .row').forEach((r, i) => {
    r.classList.toggle('cur', i === idx);
    r.classList.toggle('past', periods[i].end <= t);
  });
}

/* ============ SCHEDULE TIMES VIEW ============ */
function renderTimes() {
  $('timesBody').innerHTML = Object.keys(SCHEDULES).map(key => {
    const rows = [];
    SCHEDULES[key].periods.forEach(p => {
      if (typeof p[1] === 'object') {
        ['A', 'B', 'C'].forEach(l => rows.push([`${p[0]} · Lunch ${l}`, ...p[1][l]]));
      } else rows.push(p);
    });
    return `<div class="box"><h3>${SCHEDULES[key].title}</h3>` +
      rows.map(r => `<div class="row"><span>${r[0]}</span><span class="t">${r[1]} – ${r[2]}</span></div>`).join('') + '</div>';
  }).join('');
}

/* ============ EVENTS ============ */
document.querySelectorAll('#menu .choice[data-s]').forEach(b =>
  b.addEventListener('click', () => {
    chime.primed = true; // user gesture unlocks audio
    try { audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)(); audioCtx.resume(); } catch (e) {}
    runLoading(1200, () => startSchedule(b.dataset.s));
  }));
$('showTimes').addEventListener('click', () => { renderTimes(); show('times'); });
$('backMenu').addEventListener('click', () => show('menu'));
$('change').addEventListener('click', () => { clearInterval(timerId); document.title = 'Bell Schedule'; show('menu'); });
document.querySelectorAll('#lunchRow button').forEach(b => b.addEventListener('click', () => setLunch(b.dataset.l)));

/* ============ BOOT ============ */
runLoading(2600, () => show('menu'));
</script>
</body>
